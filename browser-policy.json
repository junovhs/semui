{
  "playwright_version": "1.61.0",
  "browser": "chromium",
  "browser_version": "149.0.7827.55",
  "viewport": {
    "width": 800,
    "height": 600
  },
  "device_scale_factor": 1,
  "locale": "en-US",
  "timezone": "UTC",
  "color_scheme": "light",
  "reduced_motion": "reduce",
  "animation_policy": "disabled_by_injected_css",
  "network_policy": "all_requests_aborted",
  "font_package": "@fontsource/inter@5.2.8",
  "font_weights": [400, 500, 600, 700],
  "exact_computed_styles": [
    "position",
    "display",
    "box-sizing",
    "flex-direction",
    "align-items",
    "justify-content",
    "align-self",
    "cursor",
    "font-family",
    "font-weight",
    "background-color",
    "border-color",
    "color"
  ],
  "numeric_computed_styles": [
    "top",
    "left",
    "width",
    "height",
    "min-width",
    "margin-top",
    "margin-right",
    "margin-bottom",
    "margin-left",
    "padding-top",
    "padding-right",
    "padding-bottom",
    "padding-left",
    "gap",
    "border-top-width",
    "border-radius",
    "font-size",
    "line-height"
  ],
  "numeric_tolerance_px": 1,
  "visual": {
    "channel_delta_threshold": 0,
    "max_differing_pixel_ratio": 0.005,
    "max_diff_region_width": 8,
    "max_diff_region_height": 8
  }
}
